# Copy to .upstash.env (gitignored) to turn on the CI beacon at the end of `just vet`.
#
# The beacon is one Upstash Redis REST key that ci.yml SETs at the end of every
# run, and scripts/git/check_ci.sh GETs. Cheaper and quieter than polling the
# GitHub API, and it means a red build cannot sit there unnoticed while you keep
# committing on top of it.
#
# Setup:
#   1. Create a free Redis database at upstash.com.
#   2. Put the REST URL and the READ-ONLY token here.
#   3. Add the WRITE token to the repo as the UPSTASH_WRITE_TOKEN secret, and
#      the URL as the UPSTASH_URL secret (ci.yml reads both).
#
# No .upstash.env means no beacon, and vet skips the step rather than failing.

UPSTASH_URL=https://your-db-name.upstash.io
UPSTASH_READ_TOKEN=replace-me
UPSTASH_KEY=LAST_CI_BUILD
